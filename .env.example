# PostgreSQL — from Railway (auto-filled when you add PostgreSQL plugin)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# YouTube Data API v3 — Google Cloud Console (free)
YOUTUBE_API_KEY=

# Micah Stokes YouTube channel ID
MICAH_STOKES_CHANNEL_ID=

# Anthropic / Claude API — console.anthropic.com
ANTHROPIC_API_KEY=

# Twitter/X Bearer Token — optional
TWITTER_BEARER_TOKEN=
MICAH_STOKES_TWITTER_ID=

# Protects the manual agent trigger (set any random string)
AGENT_SECRET=changeme123

NEXT_PUBLIC_APP_URL=https://your-app.railway.app
